class_name HandoutData
extends Resource

## Подачка наставника: набор товара, который выдаётся бесплатно, когда игрок
## не может купить вообще ничего и склад пуст.
##
## Существует ради одного случая — тупика. Он достижим двумя путями: неудачный
## день, после которого денег меньше самого дешёвого лота, и покупка лавки,
## после которой на руках ноль по определению. Без подачки партия в обоих
## случаях просто перестаёт продолжаться, а игру про эксперименты с проклятым
## товаром нельзя запирать за один неверный рейс.
##
## Условие выдачи проверяется по факту нищеты, а не по остатку места на полке:
## иначе бесплатным товаром выгодно было бы затыкать щели каждый день,
## и аварийная механика превратилась бы в ежедневную рутину.
##
## Набор — массив с повторами (две чаши, ларец, ваза), а не пары
## «предмет + количество»: повторов единицы, а инспектор для массива с
## дублями понятнее, чем вложенные ресурсы со счётчиками.

@export var name_key: String = ""
@export var hint_key: String = ""
@export var items: Array[ItemData] = []
