class_name UpgradeData
extends Resource

## Описание прокачки: что продаёт наставник и почём.
##
## Эффекта здесь нет и не будет. Прокачек на джем набирается две-три, и каждая
## трогает свой угол игры: лавка закрывает партию, борта перестраивают тело
## грузовика, крышка добавляет ему деталь. Общего языка описания у таких
## эффектов не существует, а придуманный даст слой, через который всё равно
## придётся ходить свитчем по id. Поэтому здесь только данные витрины,
## а применение — одним разветвлением в стадии закупа.
##
## Уровни (борта 1 → 2 → 3) делаются отдельными записями каталога, а не
## счётчиком внутри одной: так «купленное» остаётся булевым и хранится
## в GameState списком идентификаторов.

@export var id: StringName = &""
## Ключи локализации, а не готовый текст: строки живут в localization/ui.csv.
@export var name_key: String = ""
@export var hint_key: String = ""
@export var price: int = 100


func get_display_name() -> String:
	return tr(name_key) if not name_key.is_empty() else ""


func get_hint() -> String:
	return tr(hint_key) if not hint_key.is_empty() else ""
