class_name UpgradeData
extends Resource

## Линия прокачки: что продаёт наставник, почём и в сколько ступеней.
##
## Линия, а не единичная покупка. Первая версия описывала ровно одну покупку,
## и уровни (борта 1 → 2 → 3) предполагалось заводить отдельными записями
## каталога. На двух-трёх прокачках это работало, но набор разросся до пяти
## линий по две-четыре ступени: пятнадцать записей означали бы пятнадцать
## веток разветвления по идентификатору, и забытая ветка молча съедала бы
## купленный уровень. Теперь ступени лежат таблицей внутри линии, а код
## спрашивает не «куплено ли», а «какое сейчас значение».
##
## Эффекта здесь по-прежнему нет: линия хранит числа, а смысл им придаёт
## тот, кто их применяет. Что означает value каждой ступени — написано
## в UpgradeLevel.

## Идентификатор линии. По нему стадии спрашивают текущее значение,
## поэтому менять его после того, как он попал в код, нельзя.
@export var id: StringName = &""
## Ключи локализации, а не готовый текст: строки живут в localization/ui.csv.
@export var name_key: String = ""
@export var hint_key: String = ""

## Значение параметра без единой купленной ступени. Живёт здесь, а не в сцене
## грузовика: иначе базовая высота борта была бы записана в двух местах,
## и они разъехались бы при первой же правке в инспекторе.
@export var base_value: float = 1.0

## Ступени по возрастанию. Порядок в массиве — порядок покупки.
@export var levels: Array[UpgradeLevel] = []


func get_display_name() -> String:
	return tr(name_key) if not name_key.is_empty() else ""


func get_hint() -> String:
	return tr(hint_key) if not hint_key.is_empty() else ""


## Сколько ступеней у линии. Ноль означает линию без прокачки — такая
## отдаёт только base_value и на витрине не появляется.
func level_count() -> int:
	return levels.size()


## Значение на указанном уровне. Уровень 0 — это база, уровень N — N-я
## ступень. Выход за границы не ошибка: уровень приходит из состояния игры,
## а каталог правится в инспекторе, и укоротить таблицу уровней должно быть
## можно, не роняя сохранённую партию.
func value_at(level: int) -> float:
	if level <= 0 or levels.is_empty():
		return base_value
	var index: int = mini(level, levels.size()) - 1
	var step := levels[index]
	return step.value if step != null else base_value


## Цена перехода на указанный уровень. Ноль означает, что такой ступени нет.
func price_at(level: int) -> int:
	if level <= 0 or level > levels.size():
		return 0
	var step := levels[level - 1]
	return step.price if step != null else 0
