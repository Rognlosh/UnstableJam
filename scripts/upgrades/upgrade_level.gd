class_name UpgradeLevel
extends Resource

## Одна ступень прокачки: во что обходится и что даёт.
##
## Что именно означает value, знает не эта запись, а тот, кто прокачку
## применяет: у бортов это высота в пикселях, у полок — их число, у мотора
## и обивки — множитель к базовому значению. Общего языка описания эффектов
## не существует, и попытка его завести дала бы слой, через который всё равно
## пришлось бы ходить разветвлением по идентификатору линии.
##
## Одно число на ступень — сознательное ограничение. Прокачке, которой нужны
## два числа (мотор трогает и момент, и потолок оборотов), второе выводится
## из первого правилом на стороне применения. Так таблица уровней остаётся
## читаемой в инспекторе.

## Цена перехода на эту ступень, а не суммарная стоимость линии:
## игрок платит по одной ступени за раз.
@export var price: int = 100

## Значение параметра на этой ступени.
@export var value: float = 1.0
