class_name WorldPalette
extends Resource

## Цвета мира одним ресурсом. До неё цвет земли лежал числом в шестнадцати
## сценах кусков и ещё раз в коде стадии — поменять палитру значило пройти
## по всем и ничего не забыть.
##
## Цвета в сценах кусков остаются, но теперь это лишь превью для редактора:
## в игре сборщик перекрашивает куски отсюда.

## Земля в толще: и куски трассы, и пристройка у стартовой стены.
## Это самый нижний слой, он же виден в стенках глубоких ям.
@export var ground: Color = Color(0.541, 0.353, 0.188, 1.0)

## Слои грунта сверху вниз. Порядок и толщины заданы в TrackChunk;
## здесь только цвет, потому что менять оттенок земли хочется чаще,
## чем её устройство.
## Небо на заезде. Отдельно от подложки меню: там нарочно темно и холодно
## под тёплый товар, а над дорогой должен быть день.
@export var sky: Color = Color(0.78, 0.88, 0.91, 1.0)

@export_group("Слои грунта")
## Дёрн — самая верхняя полоса, по ней едет машина.
@export var soil_turf: Color = Color(0.557, 0.820, 0.208, 1.0)
## Песчаная прослойка: та самая дорога, только в разрезе.
@export var soil_sand: Color = Color(0.969, 0.851, 0.573, 1.0)
## Кайма песка сверху и снизу. Тонкая линия читается как рисованный
## контур и держит слоёный пирог от расплывания в градиент.
@export var soil_sand_edge: Color = Color(0.878, 0.710, 0.396, 1.0)
## Второй дёрн, ниже песка. Темнее верхнего: он в тени.
@export var soil_subturf: Color = Color(0.498, 0.765, 0.192, 1.0)
## Кайма нижнего дёрна на границе с толщей.
@export var soil_subturf_edge: Color = Color(0.333, 0.533, 0.110, 1.0)
@export_group("")
## Дерево: стеллаж и его стойки.
@export var timber: Color = Color(0.42, 0.33, 0.24, 1.0)

## Подложка экранов меню. Тёмная и холодная нарочно: товар в игре тёплый
## (охра, глина, латунь), и на такой подложке он читается силуэтом,
## а не сливается с ней в общее пятно.
@export var backdrop: Color = Color(0.13, 0.15, 0.2, 1.0)
