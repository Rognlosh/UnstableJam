class_name WorldPalette
extends Resource

## Цвета мира одним ресурсом. До неё цвет земли лежал числом в шестнадцати
## сценах кусков и ещё раз в коде стадии — поменять палитру значило пройти
## по всем и ничего не забыть.
##
## Цвета в сценах кусков остаются, но теперь это лишь превью для редактора:
## в игре сборщик перекрашивает куски отсюда.

## Земля: и куски трассы, и пристройка у стартовой стены.
@export var ground: Color = Color(0.5563933, 0.5271128, 0.49560964, 1.0)
## Дерево: стеллаж и его стойки.
@export var timber: Color = Color(0.42, 0.33, 0.24, 1.0)

## Подложка экранов меню. Тёмная и холодная нарочно: товар в игре тёплый
## (охра, глина, латунь), и на такой подложке он читается силуэтом,
## а не сливается с ней в общее пятно.
@export var backdrop: Color = Color(0.13, 0.15, 0.2, 1.0)
