# Godot 4+ specific ignores
.godot/
/android/

# Временные файлы, которые Godot оставляет при сохранении сцен
*.tmp

# Переводы, собранные из localization/ui.csv. Это артефакт импорта:
# Godot пересобирает их из .csv при открытии проекта, а в репозитории они
# только расходятся с исходником и затирают свежие ключи при откате правок.
localization/*.translation
